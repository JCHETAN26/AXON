# ── Generation (optional) ──────────────────────────────────────────────────
# Enables live model generation in the workspace. Without a key, AXON uses a
# deterministic offline template provider and labels the result accordingly.
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override for generation (default: claude-opus-4-8).
ANTHROPIC_MODEL=
# Set to "offline" to force the offline template provider (used in e2e tests).
AXON_GENERATION_MODE=

# ── Persistence mode (private beta infrastructure) ──────────────────────────
# Explicit, validated selection between local and cloud persistence. In
# production this MUST be set: an unset value fails closed rather than silently
# falling back to anonymous/local behavior. Cloud mode additionally requires
# DATABASE_URL and AUTH_SECRET (validated at startup).
#   local | cloud   (defaults to "local" only outside production)
AXON_PERSISTENCE_MODE=cloud

# The same value, exposed to browser code so it talks to the right store. Not a
# security boundary — the server independently enforces auth and owner-scoping.
NEXT_PUBLIC_AXON_PERSISTENCE_MODE=cloud

# Cloud-mode PostgreSQL connection.
# Supabase transaction pooler (port 6543) for the app runtime; prepare:false.
DATABASE_URL=
# Supabase direct connection (port 5432) for migrations only.
DATABASE_MIGRATION_URL=
# Auth.js. AUTH_SECRET is required in cloud mode; generate with
#   npx auth secret
AUTH_SECRET=

# GitHub OAuth (the initial production sign-in provider). Only identity scopes
# are requested — no repository access. Callback URL:
#   https://<host>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub App (Checkpoint 5) — a SEPARATE credential flow from the OAuth App
# above. It grants read-only repository access (Metadata: read, Contents: read)
# for architecture analysis and must never be merged with login. All values are
# server-only and never reach the client. When unset/incomplete, repository
# connection is disabled. The private key may be single-line with \n escapes.
# Callback (setup) URL: https://<host>/api/connections/github/callback
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
# Webhook secret — used only to verify inbound delivery signatures (HMAC-SHA256).
# When unset, the webhook endpoint rejects deliveries (processing disabled).
GITHUB_APP_WEBHOOK_SECRET=

# Shared bearer secret an external scheduler/cron presents to POST /api/jobs/drain
# (Authorization: Bearer <secret>) to process queued webhook jobs. AXON runs no
# always-on worker. When unset, the drain endpoint is disabled (503).
AXON_JOBS_DRAIN_SECRET=

# Application URL — required in production; used for OAuth callbacks and
# request-origin validation.
AXON_APP_URL=

# Deterministic test-auth. Only honoured when NODE_ENV != "production"; it fails
# closed in production and is never a hidden bypass. Used by automated tests.
AXON_TEST_AUTH=

# ── Generation controls (production) ────────────────────────────────────────
# Set to "false" to disable AI generation entirely (offline template only).
AXON_GENERATION_ENABLED=
# AI provider (default: anthropic).
AXON_AI_PROVIDER=
# Optional positive integer overrides for generation limits (validated).
AXON_GENERATION_DAILY_LIMIT=
AXON_GENERATION_PER_MINUTE_LIMIT=
AXON_GENERATION_CONCURRENCY_LIMIT=

# ── Legal / trust (required in production) ──────────────────────────────────
AXON_LEGAL_COMPANY_NAME=
AXON_LEGAL_SUPPORT_EMAIL=
AXON_LEGAL_PRIVACY_EMAIL=
AXON_LEGAL_EFFECTIVE_DATE=
AXON_LEGAL_JURISDICTION=

# ── Operational ─────────────────────────────────────────────────────────────
# Safe public build identifier shown by /api/health and in exports.
AXON_BUILD_ID=
# In-process PGlite runtime driver — LOCAL/TEST ONLY, rejected in production.
AXON_DB_DRIVER=
# Enables `pnpm verify:postgres` against a staging database. Never production
# unless AXON_VERIFICATION_ALLOW_DESTRUCTIVE=yes-i-understand is also set.
AXON_VERIFICATION_MODE=
